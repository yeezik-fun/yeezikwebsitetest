---
import { u } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import Wordmark from '../components/Wordmark.astro';
---
<Layout title="Not found — YEEZIK" description="This page does not exist." active="home">
  <main>
    <section class="page-head wrap">
      <Wordmark text="404" cls="page-word" />
    </section>
    <section class="section wrap">
      <p class="stagger">
        <span class="i1">This page is still</span>
        <span class="accent">unknown <i class="dash"></i> like the next level</span>
      </p>
      <div class="pills" style="margin-top:48px"><a class="pill on" href={u("/")}>Back home</a></div>
    </section>
  </main>
</Layout>
